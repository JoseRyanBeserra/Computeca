{
  "name": "mi-server",
  "version": "1.0.0",
  "description": "Back-end da Plataforma de Gestão de Materiais Instrucionais — Campus IV UFPB",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:otel": "tsx watch --env-file-if-exists=.env --import @opentelemetry/auto-instrumentations-node/register src/server.ts",
    "start:otel": "node --env-file-if-exists=.env --require @opentelemetry/auto-instrumentations-node/register dist/server.js",
    "build": "tsup src/server.ts src/workers/vectorizeWorker.ts --format cjs --out-dir dist",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "worker": "tsx src/workers/vectorizeWorker.ts",
    "worker:dev": "tsx watch src/workers/vectorizeWorker.ts",
    "worker:otel": "tsx watch --env-file-if-exists=.env --import @opentelemetry/auto-instrumentations-node/register src/workers/vectorizeWorker.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "author": "Campus IV UFPB",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "minio": "^8.0.7",
    "nodemailer": "^8.0.10",
    "openai": "^6.44.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
