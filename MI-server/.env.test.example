# ──────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente para testes (unit + integration)
# Copie este arquivo para .env.test e preencha com valores locais.
# NUNCA versione o .env.test com valores reais.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=test
PORT=3334

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Crie um banco separado para testes (ex: mi_db_test) para não sujar o de dev
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db_test>

# ── JWT ────────────────────────────────────────────────────────────────────────
# Gere uma string aleatória: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<gere-uma-string-aleatoria-de-no-minimo-32-chars>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── bcrypt ─────────────────────────────────────────────────────────────────────
# Use 4 em testes para velocidade (produção usa 12)
BCRYPT_SALT_ROUNDS=4

# ── Admin seed ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=<senha-de-teste-minimo-8-chars>

# ── Rate limiting ──────────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_SECONDS=900
