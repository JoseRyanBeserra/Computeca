# ATENCAO (Windows + Docker Desktop): use 127.0.0.1, nao localhost. O localhost
# resolve primeiro para ::1 e o relay IPv6 do Docker Desktop falha de forma
# intermitente — a conexao fica pendurada ate dar timeout, sem mensagem de erro.

# App
NODE_ENV=development
PORT=3333

# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mi_db"

# JWT
JWT_SECRET=troque_por_segredo_forte_aqui
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Admin seed
ADMIN_EMAIL=admin@dcx.ufpb.br
ADMIN_PASSWORD=troque_em_producao

# Rate limit (login)
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_SECONDS=900

# E-mail (SMTP) — Gmail via App Password
# Gere a App Password em: Conta Google → Segurança → Verificação em duas etapas → Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mi.server.back@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=MI UFPB <mi.server.back@gmail.com>
APP_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# MinIO (armazenamento de PDFs)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=materiais-instrucionais

# Redis (BullMQ — jobs assíncronos)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Qdrant (banco de vetores)
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=  # apenas se usar Qdrant Cloud

# OpenAI (embeddings)
OPENAI_API_KEY=sk-proj-...

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# Preencha no seu .env local. Endpoint, nome de servico e token sao fornecidos
# pela disciplina — nao versione nenhum desses valores.
#
# A telemetria e opt-in: sem OTEL_EXPORTER_OTLP_ENDPOINT definido, o SDK nem
# e carregado e a aplicacao roda normalmente, sem exportar nada.
#
# Alternativa para desenvolvimento offline: `docker compose up -d otel-lgtm`
# sobe a stack completa localmente; aponte o endpoint para o coletor local e
# deixe OTEL_EXPORTER_OTLP_HEADERS vazio.

OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# Lista explícita de detectores de recurso. Exclui os de nuvem (GCP/AWS/Azure),
# que travam o boot tentando alcançar metadata.google.internal / 169.254.169.254.
# ATENÇÃO: a ordem importa — o último vence. `env` precisa ficar por último, senão
# o detector `process` sobrescreve o service.name com "unknown_service:node.exe".
OTEL_NODE_RESOURCE_DETECTORS=host,os,process,serviceinstance,container,env
